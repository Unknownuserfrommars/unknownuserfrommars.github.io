# Caddy config for kevin-z.com.
#
# Deploy: copy this repo to the server, point `root` at it, then
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Only index.html and og.jpg are deployed to the public web root. The private
# matcher is defense in depth in case build inputs are ever copied there.

kevin-z.com, www.kevin-z.com {
	root * /var/www/kevin-z.com

	encode zstd gzip

	# Build inputs and repo metadata are not public.
	@private path /_* /build.js /Caddyfile /README.md /.git /.git/* /_config.yml
	respond @private 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	# The page is one file; the OG image is the only heavy asset.
	@static path *.jpg *.png *.svg *.ico *.woff2
	header @static Cache-Control "public, max-age=604800, immutable"
	header /index.html Cache-Control "public, max-age=0, must-revalidate"

	file_server
}

# Existing app on the same server. Keep this block when deploying the portfolio.
travelyou.kevin-z.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/caddy/travelyou-access.log
		format console
	}
}
